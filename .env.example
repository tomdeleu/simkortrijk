# Optional local settings. Copy to .env (never committed); the pipeline loads it.
# Dev preview of an exported area does not need any of the Cloudflare values.

# Public origin of the R2 bucket (its custom domain), e.g. https://tiles.example.com
# Empty: `npm run dev` serves only data/web (the export cache) and does not proxy to R2.
TILES_ORIGIN=
# Cloudflare account that owns the bucket and the Worker (Workers & Pages → Account ID)
CLOUDFLARE_ACCOUNT_ID=
# Domain the site is deployed to by `npm run deploy`, e.g. maps.example.com
SITE_DOMAIN=

# R2 write token for `npm run publish` (Object Read & Write on bucket simkortrijk-tiles).
# Without it, publish uses `npx wrangler login`.
CLOUDFLARE_API_TOKEN=

# Painting. Default provider is the Codex CLI (`codex` on PATH, ChatGPT login, no API key).
# Set openai to call the Images API instead. That needs the secret OPENAI_API_KEY.
# Optional OPENAI_IMAGE_MODEL (default gpt-image-1).
PAINT_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Chromium used by the renderer and the test scripts. Auto-detected when unset
# (chromium, then google-chrome). Launch flags default to --enable-gpu; the renderer
# also passes --enable-unsafe-swiftshader for machines without a GPU.
CHROME_PATH=
CHROME_ARGS=

# The running site the test and film scripts open when no URL is passed.
SITE_URL=http://localhost:4321/
