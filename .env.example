# Optional local settings. Copy to .env (never committed); the pipeline loads it.
# Dev preview of an exported area does not need any of the Cloudflare values.

# Where the site loads tiles. Unset (default): the R2 bucket `simkortrijk` at
# https://pub-74f69231228247acb76f1009b1fa86f5.r2.dev (pipeline/src/hosting.ts), for `npm run dev` and `npm run build` alike.
# Set to a custom domain on that bucket for production. Set it empty (TILES_ORIGIN=) to ship
# tiles inside the Worker instead (scripts/copy-regions.mjs copies them into web/dist).
# TILES_ORIGIN=
# Cloudflare account that owns the Worker (Workers & Pages → Account ID). Needed for R2 publish.
CLOUDFLARE_ACCOUNT_ID=
# Optional custom domain for `npm run deploy`, e.g. maps.example.com.
# Unset: the Worker is only on workers.dev (wrangler.jsonc workers_dev).
SITE_DOMAIN=

# R2 write token for `npm run publish` (Object Read & Write on bucket simkortrijk).
# Without it, publish uses `npx wrangler login`.
CLOUDFLARE_API_TOKEN=

# Painting. Default is Gemini Nano Banana (image edits). Secret GEMINI_API_KEY.
# Optional GEMINI_IMAGE_MODEL (default gemini-nano-banana-2.1). 1K is $0.0336;
# the Batch API, used automatically above 12 windows, is half that.
# PAINT_PROVIDER=codex uses the Codex CLI (no key). PAINT_PROVIDER=openai needs OPENAI_API_KEY.
PAINT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Chromium used by the renderer and the test scripts. Auto-detected when unset
# (chromium, then google-chrome). Launch flags default to --enable-gpu; the renderer
# also passes --enable-unsafe-swiftshader for machines without a GPU.
CHROME_PATH=
CHROME_ARGS=

# The running site the test and film scripts open when no URL is passed.
SITE_URL=http://localhost:4321/
