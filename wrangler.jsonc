// One Worker. Pages and map tiles are static assets of web/dist.
// `npm run build` copies data/web/regions into web/dist/regions, so /regions/... is
// same-origin and R2 is not required. worker/index.ts runs only for /p/* (optional Pirsch).
// Deploy: npx wrangler deploy   (workers.dev; name simkortrijk)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simkortrijk",
  "workers_dev": true,
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // tiles and pages are assets; the Worker runs only for the analytics proxy
    "run_worker_first": ["/p/*"],
    // unknown paths get 404.html, which sends /Kortrijk to /kortrijk
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
