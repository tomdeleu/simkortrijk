// Cloudflare Workers static site: only the built pages (web/dist, a few hundred KB).
// Map tiles and region data are served from R2 (pipeline/src/hosting.ts), not from here.
// worker/index.ts runs only for /p/* (first-party Pirsch Analytics proxy; secret PIRSCH_ACCESS_KEY).
// Deploy with `npm run deploy` (needs SITE_DOMAIN in .env).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simkortrijk",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // everything else is served straight from assets, without invoking the Worker
    "run_worker_first": ["/p/*"],
    // unknown paths get 404.html, which sends capitalised city links (/Tel-Aviv-Yafo) to /tel-aviv-yafo
    "not_found_handling": "404-page",
    // /tel-aviv-yafo, not /tel-aviv-yafo/
    "html_handling": "drop-trailing-slash"
  }
  // custom domain: SITE_DOMAIN in .env, passed by `npm run deploy` (pipeline/src/deploy.ts)
}
