---
/** The map page of one city: its region's flat map, opened centred on the city. */
import { CITIES, REGIONS } from "../../../pipeline/src/places.ts";
import { existsSync, readFileSync } from "node:fs";
import { HOSTING } from "../../../pipeline/src/hosting.ts";
declare const __WEB_CACHE__: string; // data/web/, injected by astro.config.mjs
interface Props { city: string; home?: boolean }
interface Preview { file: string; lqip: string }
interface World { files?: Record<string, string>; previews?: Record<string, { land: Preview; port: Preview }> }
const { city, home = false } = Astro.props;
const c = CITIES[city], region = REGIONS[c.region];
// map data comes from R2 (same-origin /regions in dev): start its downloads with the HTML, not after the script
const tilesOrigin = import.meta.env.DEV ? "" : HOSTING.origin;
const regionBase = `${tilesOrigin}/regions/${c.region}`, data = `${regionBase}/data`;
// the region's world.json as published (in dev: the export cache first, as the dev server serves it):
// names of the current content-hashed files to preload, and the city's preview
async function loadWorld(): Promise<World> {
  const local = `${__WEB_CACHE__}regions/${c.region}/data/world.json`;
  if ((import.meta.env.DEV || !HOSTING.origin) && existsSync(local)) return JSON.parse(readFileSync(local, "utf8"));
  if (!HOSTING.origin) return {};
  try {
    const r = await fetch(`${HOSTING.origin}/regions/${c.region}/data/world.json?build=${Date.now()}`);
    return r.ok ? await r.json() : {};
  } catch { return {}; }
}
const world = await loadWorld();
const preload = world.files ? [world.files["tiles-map"], world.files.borders].filter(Boolean) : ["tiles.json", "borders.json"];
const pv = world.previews?.[city];
const title = home ? "SimKortrijk" : `${c.title} · SimKortrijk`;
const description = home ? "Kortrijk as an isometric map, built from Flemish open data." : `${c.title}: an isometric map from Flemish open data.`;
// crawlers need absolute URLs: site comes from SITE_DOMAIN (astro.config.mjs)
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), site).href, ogImage = new URL(`/og/${home ? "index" : city}.jpg`, site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0e0f12" />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		{tilesOrigin && <link rel="preconnect" href={tilesOrigin} crossorigin="anonymous" />}
		<link rel="preload" href={`${data}/world.json`} as="fetch" crossorigin="anonymous" />
		{preload.map((f) => <link rel="preload" href={`${data}/${f}`} as="fetch" crossorigin="anonymous" />)}
		<meta name="description" content={description} />
		{/* social cards: web/public/og/<city>.jpg, made by pipeline/src/og.ts from the published tiles */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="SimKortrijk" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={home ? "Isometric World, an isometric city map from open data" : `${c.title}, isometric city map`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{/* Pirsch Analytics (cookie-free), proxied first-party by worker/index.ts; the access key is a Worker secret */}
		{!import.meta.env.DEV && <script is:inline defer src="/p/s.js" id="pianjs" data-hit-endpoint="/p/v" data-event-endpoint="/p/e" data-session-endpoint="/p/k"></script>}
	</head>
	<body data-city={city} data-region={c.region}>
		<div id="map"></div>
		{pv && (
			/* the opening view as one image (and a blurred inline version until it loads); map.ts fades it out
			   once the tiles are in. Laid out like the viewer opens the city: full width, centred vertically. */
			<div id="preview" aria-hidden="true" style={`--lqip-land: url(${pv.land.lqip}); --lqip-port: url(${pv.port.lqip})`}>
				<div class="frame">
					<div class="lqip"></div>
					<picture>
						<source media="(max-aspect-ratio: 5/4)" srcset={`${regionBase}/${pv.port.file}`} type="image/avif" />
						<img src={`${regionBase}/${pv.land.file}`} alt="" fetchpriority="high" decoding="async" />
					</picture>
				</div>
			</div>
		)}
		<script is:inline>
			// a deep link (#@x,y,z, #metro, ?at=) opens somewhere else: no preview
			if (/^#(@|metro)/.test(location.hash) || new URLSearchParams(location.search).has("at")) document.getElementById("preview")?.remove();
		</script>
		<footer id="credits"></footer>
		<!-- video mode (?video or V): big credit line above the area social apps cover with their UI -->
		<div id="video-credit">{region.credits.map((line, i) => <>{i > 0 && <br />}{line}</>)}</div>

		<style is:global>
			html, body { margin: 0; height: 100%; background: #0e0f12; font-family: ui-sans-serif, system-ui, sans-serif; overflow: hidden;
				overscroll-behavior: none; -webkit-tap-highlight-color: transparent; -webkit-text-size-adjust: 100%; }
			/* the map owns every gesture: no browser pan/pinch/double-tap zoom of the page, no long-press callout */
			#map { touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
			#map { position: fixed; inset: 0; background: #0e0f12; }
			#preview { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; background: #0e0f12; }
			/* landscape: the image is 0.8 × as tall as wide; portrait and squarish screens: 2.2 × (export.ts PREVIEWS) */
			#preview .frame { position: absolute; left: 0; top: 50%; width: 100%; aspect-ratio: 1 / 0.8; transform: translateY(-50%); }
			#preview .lqip { position: absolute; inset: 0; background: var(--lqip-land) center / 100% 100%; filter: blur(12px); }
			#preview img { position: absolute; inset: 0; width: 100%; height: 100%; }
			@media (max-aspect-ratio: 5/4) {
				#preview .frame { aspect-ratio: 1 / 2.2; }
				#preview .lqip { background-image: var(--lqip-port); }
			}
			#overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
			#credits { position: fixed; right: 0; bottom: 0; z-index: 10; font-size: 11px; line-height: 1.4; max-width: calc(100vw - 48px);
				padding: 3px calc(8px + env(safe-area-inset-right, 0px)) calc(3px + env(safe-area-inset-bottom, 0px)) 8px;
				background: rgba(255, 255, 255, 0.85); color: #333; border-top-left-radius: 6px; }
			#credits .credit { white-space: nowrap; }
			#credits a { color: #0b63c5; text-decoration: none; touch-action: manipulation; }
			@media (pointer: coarse) { #credits { font-size: 12px; } #credits a { padding: 4px 0; } }
			/* phones: a full-width bar with left-aligned lines, clear of the notch corners and the home indicator */
			@media (max-width: 640px) {
				#credits { left: 0; max-width: none; border-radius: 0; text-align: left;
					padding: 5px calc(12px + env(safe-area-inset-right, 0px)) calc(5px + env(safe-area-inset-bottom, 0px)) calc(12px + env(safe-area-inset-left, 0px)); }
			}
			#video-credit { display: none; position: fixed; z-index: 10; left: 50%; bottom: calc(9svh + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%);
				width: max-content; max-width: 92vw; padding: 0.35em 0.8em; border-radius: 0.5em; text-align: center;
				font-size: clamp(10px, 1.55vmin, 15px); font-weight: 500; line-height: 1.4; color: rgba(255, 255, 255, 0.95);
				background: rgba(10, 12, 16, 0.42); backdrop-filter: blur(4px); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); pointer-events: none; }
			body.video #video-credit { display: block; }
			body.video #credits { display: none; }
		</style>

		<script>
			import '../scripts/map.ts';
		</script>
	</body>
</html>
