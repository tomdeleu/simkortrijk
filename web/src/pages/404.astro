---
/**
 * Unknown path. City links are lowercase (/tel-aviv-yafo); links shared with capitals
 * (/Tel-Aviv-Yafo) or spaces/underscores are sent to the right city. Static hosts serve this page
 * for any missing path, so the redirect works without server rules.
 */
import { CITIES } from "../../../pipeline/src/places.ts";
const slugs = Object.keys(CITIES);
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e0f12" />
		<meta name="color-scheme" content="dark" />
		<title>Not found · SimKortrijk</title>
		<script is:inline define:vars={{ slugs }}>
			const want = decodeURIComponent(location.pathname).replace(/^\/+|\/+$/g, "").toLowerCase().replace(/[\s_]+/g, "-");
			if (slugs.includes(want)) location.replace(`/${want}${location.search}${location.hash}`);
		</script>
		<style>
			body { margin: 0; min-height: 100svh; -webkit-tap-highlight-color: transparent; display: grid; place-items: center; background: #0e0f12; color: #ddd; font-family: ui-sans-serif, system-ui, sans-serif; }
			a { color: #8ab4ff; }
		</style>
	</head>
	<body>
		<p>No such place. <a href="/">Open the map</a></p>
	</body>
</html>
